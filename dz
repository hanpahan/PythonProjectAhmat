import sqlite3
from datetime import datetime, timedelta

con = sqlite3.connect(":memory:")
con.executescript("""
PRAGMA foreign_keys=ON;
CREATE TABLE clients(id INTEGER PRIMARY KEY, name TEXT NOT NULL, phone TEXT NOT NULL UNIQUE);
CREATE TABLE staff(id INTEGER PRIMARY KEY, name TEXT NOT NULL);
CREATE TABLE kinds(id INTEGER PRIMARY KEY, name TEXT NOT NULL UNIQUE, rate REAL NOT NULL CHECK(rate>=0));
CREATE TABLE items(id INTEGER PRIMARY KEY, inv TEXT NOT NULL UNIQUE, kind_id INTEGER NOT NULL REFERENCES kinds(id),
                   status TEXT NOT NULL DEFAULT 'free' CHECK(status IN ('free','rented','repair')));
CREATE TABLE rentals(id INTEGER PRIMARY KEY, client_id INTEGER NOT NULL REFERENCES clients(id),
                     staff_id INTEGER NOT NULL REFERENCES staff(id), started TEXT NOT NULL);
CREATE TABLE lines(id INTEGER PRIMARY KEY, rental_id INTEGER NOT NULL REFERENCES rentals(id) ON DELETE CASCADE,
                   item_id INTEGER NOT NULL REFERENCES items(id), due TEXT NOT NULL, returned TEXT,
                   price REAL NOT NULL CHECK(price>=0), UNIQUE(rental_id,item_id));
CREATE TABLE payments(id INTEGER PRIMARY KEY, rental_id INTEGER NOT NULL REFERENCES rentals(id) ON DELETE CASCADE,
                      amount REAL NOT NULL CHECK(amount>0));
CREATE UNIQUE INDEX one_active ON lines(item_id) WHERE returned IS NULL;
""")

now = datetime.now()
d = lambda n: (now + timedelta(days=n)).strftime("%Y-%m-%d")

con.executemany("INSERT INTO clients(name,phone) VALUES (?,?)",
                [("Иванов","+7001"),("Петрова","+7002"),("Сидоров","+7003")])
con.executemany("INSERT INTO staff(name) VALUES (?)", [("Смирнов",),("Кузнецова",)])
con.executemany("INSERT INTO kinds(name,rate) VALUES (?,?)",
                [("Велосипед",500),("Лыжи",300),("Самокат",200)])
con.executemany("INSERT INTO items(inv,kind_id,status) VALUES (?,?,?)", [
    ("V1",1,"rented"),("V2",1,"free"),("V3",1,"repair"),
    ("L1",2,"free"),("L2",2,"rented"),("S1",3,"free"),("S2",3,"rented")])
con.executemany("INSERT INTO rentals(client_id,staff_id,started) VALUES (?,?,?)",
                [(1,1,d(-5)),(2,1,d(-2)),(3,2,d(-35))])
con.executemany("INSERT INTO lines(rental_id,item_id,due,returned,price) VALUES (?,?,?,?,?)", [
    (1,1,d(-2),None,500),(1,4,d(-1),d(-1),300),
    (2,5,d(5),None,200),(2,7,d(5),None,200),
    (3,2,d(-30),d(-29),450)])
con.executemany("INSERT INTO payments(rental_id,amount) VALUES (?,?)",
                [(1,1000),(2,500),(3,900)])
con.commit()

def show(title, sql, p=()):
    print(f"\n{title}")
    for row in con.execute(sql, p): print(" ", row)

show("1. Доступные велосипеды", """
SELECT i.inv FROM items i
WHERE i.kind_id=1 AND i.status='free'
  AND NOT EXISTS (SELECT 1 FROM lines l WHERE l.item_id=i.id AND l.returned IS NULL)""")

show("2. Просрочено", """
SELECT c.name, c.phone, i.inv, l.due FROM lines l
JOIN rentals r ON r.id=l.rental_id
JOIN clients c ON c.id=r.client_id
JOIN items   i ON i.id=l.item_id
WHERE l.returned IS NULL AND l.due < date('now')""")

show("3. Начислено / оплачено / долг", """
SELECT id, charged, paid, ROUND(charged-paid,2) debt FROM (
  SELECT r.id,
         SUM(l.price * MAX(1, CAST(julianday(COALESCE(l.returned, date('now')))
                                    - julianday(r.started) AS INT))) charged,
         COALESCE((SELECT SUM(amount) FROM payments p WHERE p.rental_id=r.id),0) paid
  FROM rentals r JOIN lines l ON l.rental_id=r.id
  GROUP BY r.id)""")

show("4. Топ видов за месяц", """
SELECT k.name, COUNT(*) n FROM lines l
JOIN rentals r ON r.id=l.rental_id
JOIN items   i ON i.id=l.item_id
JOIN kinds   k ON k.id=i.kind_id
WHERE strftime('%Y-%m', r.started)=?
GROUP BY k.id ORDER BY n DESC, k.name""", (now.strftime('%Y-%m'),))
